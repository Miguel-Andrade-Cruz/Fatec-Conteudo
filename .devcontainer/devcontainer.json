{
  "name": "ADS container para linguagem C",
  
  "build": {
    "dockerfile": "./Dockerfile",
    "context": "."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/fatec",
  "workspaceFolder": "/fatec",
  
  "customizations": {
    "vscode": {
      "settings": {

        "drop_target_size": 2.2,
        "message_editor": {
          "auto_replace_emoji_shortcode": false
        },
        "toolbar": {
          "code_actions": false,
          "agent_review": false,
          "selections_menu": true,
          "quick_actions": false
        },
        "hover_popover_enabled": true,
        "minimum_contrast_for_highlights": 60.0,
        "unnecessary_code_fade": 0.5,
        "cursor_shape": "bar",
        "remove_trailing_whitespace_on_save": false,
        "format_on_save": "off",
        "git_panel": {
          "tree_view": true
        },
        "show_edit_predictions": false,
        "agent": {
          "favorite_models": [],
          "model_parameters": [],
          "enable_feedback": false
        },
        "formatter": "none",
      
        "colorize_brackets": true,
        "inlay_hints": {
          "show_parameter_hints": false,
          "show_type_hints": false,
          "show_value_hints": false,
          "enabled": true,
        },
      
        "hard_tabs": false,
        "drag_and_drop_selection": {
          "enabled": false,
        },
      
        "hover_popover_delay": 500,
        "diff_view_style": "unified",
        "telemetry": {
          "diagnostics": true,
          "metrics": false,
        },
      
        "session": {
          "trust_all_worktrees": true,
        },
      
        "completions": {
          "lsp": true,
        },
      
        "ui_font_size": 16,
        "ui_font_family": ".ZedMono",
        "ui_font_weight": 600,
      
        "buffer_font_size": 16,
        "buffer_font_weight": 600,
      
        "theme": {
          "mode": "system",
          "light": "Gruvbox Light Hard",
          "dark": "Gruvbox Dark",
        },
      
        "languages": {
          "JSON": {
            "auto_indent": "syntax_aware",
      
            "show_whitespaces": "all",
            "whitespace_map": {
              "space": "•",
            },
          },
      
          "Python": {
            "auto_indent": "syntax_aware",
      
            "language_servers": ["ruff", "ty"],
            "show_whitespaces": "all",
            "whitespace_map": {
              "space": "•",
            },
          },
      
          "C": {
            "auto_indent": "syntax_aware",
      
            "show_whitespaces": "all",
            "whitespace_map": {
              "space": "•",
            },
          },
        },
      
        "indent_guides": {
          "active_line_width": 3,
          "coloring": "indent_aware",
        },
      
        "extend_comment_on_newline": false,
      
        "file_types": {
          "C": ["c", "h"],
        }
      }
    }
  }, 
}
